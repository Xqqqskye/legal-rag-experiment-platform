# 复制为 .env 后填写。不要提交 .env 或真实密钥。
LLM_PROVIDER=dashscope
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL=qwen3.7-plus
DASHSCOPE_ANALYSIS_MODEL=qwen3.8-flash
DASHSCOPE_RERANK_MODEL=qwen3.7-plus
DASHSCOPE_ANSWER_MODEL=qwen3.7-plus
DASHSCOPE_EVAL_MODEL=qwen3.8-max
DASHSCOPE_ONLINE_MODEL=qwen-flash
DASHSCOPE_NATIVE_SEARCH_MODEL=qwen-flash

# 若改用 OpenAI 兼容接口，设置 LLM_PROVIDER=openai 并填写下列配置。
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_ANALYSIS_MODEL=gpt-4.1-mini
OPENAI_RERANK_MODEL=gpt-4.1-mini
OPENAI_ANSWER_MODEL=gpt-4.1-mini
OPENAI_EVAL_MODEL=gpt-4.1-mini

# Elasticsearch 与检索参数
ES_URL=http://127.0.0.1:9200
ES_BM25_INDEX=law_bm25
ES_BGE_LARGE_INDEX=law_bge_large
ES_VECTOR_FIELD=vector
BM25_TOPK=10
BGE_LARGE_TOPK=10
RRF_TOPK=20
RRF_K=60
RERANK_TOPK_FINAL=5
RAG_CTX_TOPK=5

# 向量模型。首次启动会从模型仓库下载，不要把缓存提交到 Git。
BGE_LARGE_MODEL=BAAI/bge-small-zh-v1.5
EMB_DEVICE=cpu

# 联网核验与服务参数
ONLINE_SEARCH_TIMEOUT_SECONDS=35
ONLINE_SOURCE_TIMEOUT_SECONDS=8
ONLINE_VERIFY_WORKERS=4
CORPUS_CUTOFF=2022-06-24
DEMO_HOST=127.0.0.1
DEMO_PORT=8008
DEMO_MAX_CONCURRENCY=1
MODEL_PRICING_SNAPSHOT_DATE=2026-09-11
