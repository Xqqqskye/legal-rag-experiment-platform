# 复制为 .env 后填写。不要提交 .env 或真实密钥。
LLM_PROVIDER=dashscope
# 默认直连 OpenAI-compatible API，避免继承本机代理配置导致请求挂起。
LLM_TRUST_ENV=false
LLM_VERIFY_SSL=true
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL=qwen3.7-plus
DASHSCOPE_ANALYSIS_MODEL=qwen3.8-flash
DASHSCOPE_RERANK_MODEL=qwen3.7-plus
DASHSCOPE_ANSWER_MODEL=qwen3.8-flash
DASHSCOPE_EVAL_MODEL=qwen3.8-max
DASHSCOPE_ONLINE_MODEL=qwen-flash
DASHSCOPE_NATIVE_SEARCH_MODEL=qwen-flash

# 若改用 OpenAI 兼容接口，设置 LLM_PROVIDER=openai 并填写下列配置。
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_ANALYSIS_MODEL=gpt-4.1-mini
OPENAI_RERANK_MODEL=gpt-4.1-mini
OPENAI_ANSWER_MODEL=gpt-4.1-mini
OPENAI_EVAL_MODEL=gpt-4.1-mini

# Elasticsearch 与检索参数
ES_URL=http://127.0.0.1:9200
ES_BM25_INDEX=law_bm25_latest
ES_CASE_BM25_INDEX=case_bm25_latest
# 法条和案例分别建立 BM25 索引；Dense 法条/案例检索使用对应的 Qwen3.7 FAISS 索引。
ES_VECTOR_FIELD=vector
BM25_TOPK=10
CASE_BM25_TOPK=10
QWEN37_LAW_TOPK=10
QWEN37_CASE_TOPK=8
RRF_TOPK=20
RRF_K=60
RERANK_TOPK_FINAL=5
RAG_CTX_TOPK=5

# Qwen3.7 查询编码器与离线索引配置。路径相对于 Demo 根目录，默认指向
# 工作区 data/indexes 下已生成的索引；不要把真实密钥提交到 Git。
QWEN37_EMBEDDING_MODEL=qwen3.7-text-embedding
QWEN37_EMBEDDING_DIM=1024
QWEN37_EMBEDDING_BATCH=20
# 默认直连 DashScope，避免继承本机代理配置造成请求挂起。
QWEN37_TRUST_ENV=false
QWEN37_EMBEDDING_CONNECT_TIMEOUT=5
QWEN37_EMBEDDING_READ_TIMEOUT=30
QWEN37_EMBEDDING_MAX_RETRIES=1
QWEN37_VERIFY_SSL=false
QWEN37_LAW_INDEX_DIR=../../data/indexes/law_qwen37_api_latest
QWEN37_CASE_INDEX_DIR=../../data/indexes/cases_qwen37_api_latest

# 联网核验与服务参数
ONLINE_SEARCH_TIMEOUT_SECONDS=35
ONLINE_SOURCE_TIMEOUT_SECONDS=8
ONLINE_VERIFY_WORKERS=4
CORPUS_CUTOFF=2022-06-24
DEMO_HOST=127.0.0.1
DEMO_PORT=8008
DEMO_MAX_CONCURRENCY=1
MODEL_PRICING_SNAPSHOT_DATE=2026-09-11
